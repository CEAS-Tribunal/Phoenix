<?xml version="1.0" encoding="utf-8"?>
<DieCutLabel Version="8.0" Units="twips">
	<PaperOrientation>Landscape</PaperOrientation>
	<Id>NameBadge</Id>
	<PaperName>30857 Name Badge</PaperName>
	<DrawCommands>
		<Path>
			<FillMode>EvenOdd</FillMode>
			<!-- 57mm × 102mm (3231 × 5760 twips) -->
			<RoundRectangle X="0" Y="0" Width="3231" Height="5760" Rx="180" Ry="180" />
			<RoundRectangle X="2780" Y="2520" Width="180" Height="720" Rx="120" Ry="120" />
		</Path>
	</DrawCommands>
	<ObjectInfo>
