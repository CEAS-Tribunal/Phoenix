{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "paths": {
      "@app/*": ["./src/app/*"],
      "@shared/*": ["./src/shared/*"],
      "@assets/*": ["./src/assets/*"],
      "@auth": ["./src/features/auth/index.ts"],
      "@committees": ["./src/features/committees/index.ts"],
      "@resume-review": ["./src/features/resume-review/index.ts"],
      "@career-fair": ["./src/features/career-fair/index.ts"],
      "@reimbursement": ["./src/features/reimbursement/index.ts"],
      "@org-funding": ["./src/features/org-funding/index.ts"],
      "@dashboard": ["./src/features/dashboard/index.ts"],
      "@home": ["./src/features/home/index.ts"]
    }
  },
  "include": ["src"]
}
